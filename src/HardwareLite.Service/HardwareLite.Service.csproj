<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>HardwareLite.Service</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Drawing" />
    <ProjectReference Include="../HardwareLite.Core/HardwareLite.Core.csproj" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    <Compile Include="../HardwareLite/Devices/**/*.cs" Link="Devices/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../HardwareLite/Monitoring/SensorSampler.cs" Link="Monitoring/SensorSampler.cs" />
    <Compile Include="../HardwareLite/Runtime/Autostart.cs" Link="Runtime/Autostart.cs" />
    <Compile Include="../HardwareLite/Runtime/DeviceController.cs" Link="Runtime/DeviceController.cs" />
    <Compile Include="../HardwareLite/Runtime/DeviceConflicts.cs" Link="Runtime/DeviceConflicts.cs" />
    <Content Include="../../docs/licenses/LibreHardwareMonitor.txt" Link="licenses/LibreHardwareMonitor.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/licenses/DeepCool-CH270-Lite.txt" Link="licenses/DeepCool-CH270-Lite.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/licenses/NAudio.txt" Link="licenses/NAudio.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
